<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_grad"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/cw_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ GERİ SAYIM"
        android:textColor="#D6D9FF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="4dp"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cw_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/cw_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cw_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D6D9FF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cw_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="8dp"
        android:textColor="#D6D9FF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cw_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Henüz geri sayım yok.\nUygulamaya “geri sayım sınav 15 ocak” de."
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
